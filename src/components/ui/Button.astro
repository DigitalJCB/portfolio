---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className = '' } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105 active:scale-95';

const variantClasses = {
  primary:
    'bg-[#ca7930] text-white hover:bg-[#a86225] shadow-lg shadow-[#ca7930]/30',
  secondary: 'bg-white/10 text-white hover:bg-white/20 backdrop-blur-sm border border-[#ca7930]/50',
  outline: 'border-2 border-[#ca7930] text-white hover:bg-[#ca7930]/20',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={classes}>
  <slot />
</Tag>
