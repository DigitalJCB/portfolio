---
import { SITE_INFO, SOCIAL_LINKS } from '../../utils/constants';
import Card from '../ui/Card.astro';
import { Icon } from 'astro-icon/components';
---

<section id="contact" class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold mb-4">
        Hablemos <span class="gradient-text">del Proyecto</span>
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        ¿Tienes un proyecto en mente? Me encantaría escuchar tus ideas
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Contact Form -->
      <Card>
        <h3 class="text-2xl font-bold mb-6">Envíame un mensaje</h3>
        <form
          x-data="{ loading: false, success: false, error: false }"
          @submit.prevent="
            loading = true;
            error = false;
            fetch($el.action, {
              method: 'POST',
              body: new FormData($el)
            })
            .then(res => res.json())
            .then(data => {
              loading = false;
              if (data.success) {
                success = true;
                $el.reset();
                setTimeout(() => success = false, 5000);
              } else {
                error = true;
              }
            })
            .catch(() => {
              loading = false;
              error = true;
            });
          "
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-4"
        >
          <!-- Replace with your Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="TU_WEB3FORMS_ACCESS_KEY_AQUI" />
          <input type="hidden" name="subject" value="Nuevo mensaje desde el portafolio" />
          <input type="hidden" name="from_name" value="Portafolio Contact Form" />

          <!-- Name Field -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-300 mb-2">
              Nombre
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-white placeholder-gray-500"
              placeholder="Tu nombre"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-white placeholder-gray-500"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Message Field -->
          <div>
            <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
              Mensaje
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-white placeholder-gray-500 resize-none"
              placeholder="Cuéntame sobre tu proyecto..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            :disabled="loading"
            class="w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold rounded-lg hover:from-purple-500 hover:to-blue-500 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span x-show="!loading">Enviar Mensaje</span>
            <span x-show="loading" class="flex items-center justify-center gap-2">
              <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Enviando...
            </span>
          </button>

          <!-- Success Message -->
          <div
            x-show="success"
            x-transition
            class="p-4 bg-green-500/10 border border-green-500/20 rounded-lg text-green-400"
          >
            ¡Mensaje enviado! Te responderé pronto.
          </div>

          <!-- Error Message -->
          <div
            x-show="error"
            x-transition
            class="p-4 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400"
          >
            Hubo un error. Por favor intenta de nuevo o contáctame directamente.
          </div>
        </form>
      </Card>

      <!-- Contact Info & Social Links -->
      <div class="space-y-6">
        <Card>
          <h3 class="text-2xl font-bold mb-6">Información de contacto</h3>
          <div class="space-y-4">
            <!-- Email -->
            <a
              href={SOCIAL_LINKS.email}
              class="flex items-center gap-4 text-gray-300 hover:text-white transition-colors group"
            >
              <div class="w-12 h-12 bg-purple-500/10 rounded-lg flex items-center justify-center group-hover:bg-purple-500/20 transition-colors">
                <Icon name="lucide:mail" class="w-6 h-6 text-purple-400" />
              </div>
              <div>
                <p class="font-semibold">Email</p>
                <p class="text-sm text-gray-400">{SITE_INFO.email}</p>
              </div>
            </a>

            <!-- Location -->
            {
              SITE_INFO.location && (
                <div class="flex items-center gap-4 text-gray-300">
                  <div class="w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center">
                    <Icon name="lucide:map-pin" class="w-6 h-6 text-blue-400" />
                  </div>
                  <div>
                    <p class="font-semibold">Ubicación</p>
                    <p class="text-sm text-gray-400">{SITE_INFO.location}</p>
                  </div>
                </div>
              )
            }
          </div>
        </Card>

        <Card>
          <h3 class="text-2xl font-bold mb-6">Encuéntrame en</h3>
          <div class="flex flex-wrap gap-4">
            <!-- GitHub -->
            <a
              href={SOCIAL_LINKS.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 px-4 py-3 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 hover:border-purple-500/50 transition-all group"
              aria-label="GitHub"
            >
              <Icon name="lucide:github" class="w-6 h-6 text-gray-400 group-hover:text-white" />
              <span class="text-gray-300 group-hover:text-white">GitHub</span>
            </a>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
