---
import { PROJECTS } from '../../utils/constants';
import Badge from '../ui/Badge.astro';
import { Icon } from 'astro-icon/components';
---

<section id="projects" class="py-20 px-4 bg-gradient-to-b from-transparent to-primary-surface/30">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold mb-4">
        Proyectos <span class="gradient-text">Destacados</span>
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Una selección de proyectos que muestran mis habilidades y experiencia
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr">
      {
        PROJECTS.map((project, index) => (
          <article
            class={`project-card glass-card group overflow-hidden relative ${
              project.featured ? 'md:col-span-2 md:row-span-2' : ''
            }`}
          >
            {/* Project Image Background */}
            <div class="absolute inset-0 bg-gradient-to-br from-[#471396]/30 to-[#7c3aed]/20 group-hover:from-[#471396]/40 group-hover:to-[#7c3aed]/30 transition-all duration-300">
              {/* Placeholder gradient - replace with actual images */}
              <div class="w-full h-full flex items-center justify-center">
                <Icon
                  name="lucide:layout-dashboard"
                  class="w-24 h-24 text-white/10 group-hover:text-white/20 transition-all"
                />
              </div>
            </div>

            {/* Content Overlay */}
            <div class="relative z-10 p-6 h-full flex flex-col justify-end bg-gradient-to-t from-primary-bg/90 via-primary-bg/50 to-transparent group-hover:from-primary-bg/95 transition-all duration-300">
              <div>
                <h3 class="text-2xl font-bold mb-2 text-white">{project.title}</h3>
                <p class="text-gray-300 mb-4 line-clamp-2 group-hover:line-clamp-none transition-all">
                  {project.description}
                </p>

                {/* Tags */}
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.tags.map((tag) => (
                    <Badge>{tag}</Badge>
                  ))}
                </div>

                {/* Links */}
                <div class="flex gap-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      class="flex items-center gap-2 text-[#7c3aed] hover:text-[#9d5cff] transition-colors"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon name="lucide:external-link" class="w-5 h-5" />
                      <span>Demo</span>
                    </a>
                  )}
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      class="flex items-center gap-2 text-[#9d5cff] hover:text-[#b794ff] transition-colors"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon name="lucide:github" class="w-5 h-5" />
                      <span>Código</span>
                    </a>
                  )}
                </div>
              </div>
            </div>

            {/* Hover Border Effect */}
            <div class="absolute inset-0 border-2 border-transparent group-hover:border-[#471396]/40 rounded-2xl pointer-events-none transition-all duration-300" />
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .project-card {
    min-height: 300px;
  }

  .project-card.md\:col-span-2 {
    min-height: 400px;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-none {
    display: block;
    -webkit-line-clamp: unset;
  }

  .bg-primary-surface {
    background-color: var(--color-primary-surface);
  }

  .bg-primary-bg {
    background-color: var(--color-primary-bg);
  }
</style>
