---
import { SITE_INFO, NAV_LINKS } from '../../utils/constants';
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 py-12 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Brand Section -->
      <div>
        <h3 class="text-xl font-bold gradient-text mb-4">{SITE_INFO.name}</h3>
        <p class="text-gray-400 mb-4">{SITE_INFO.tagline}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Enlaces rápidos</h4>
        <ul class="space-y-2">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Back to Top Button -->
      <div class="flex items-center justify-start md:justify-end">
        <a
          href="#hero"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 hover:bg-white/10 text-white rounded-full border border-white/10 hover:border-[#ca7930]/50 transition-all group"
        >
          <Icon name="lucide:arrow-up" class="w-5 h-5 group-hover:-translate-y-1 transition-transform" />
          <span>Volver arriba</span>
        </a>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="pt-8 border-t border-white/5">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-gray-500 text-sm">
          © {currentYear} {SITE_INFO.name}. Todos los derechos reservados.
        </p>
        <div class="flex items-center gap-2 text-gray-500 text-sm">
          <span>Hecho con</span>
          <Icon name="lucide:heart" class="w-4 h-4 text-red-500" />
          <span>usando</span>
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#ca7930] hover:text-[#d4894a] transition-colors font-semibold"
          >
            Astro
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
